# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sign in with Google (optional: the button only shows when both are set).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials (type "Web application")
# with the redirect URI http://localhost:3000/api/auth/callback/google (and your live domain's).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emailing sign-in codes, through Resend (https://resend.com). Without a key, in development
# the code is printed in the terminal running `bun run dev` instead.
RESEND_API_KEY=
# Who the emails are from; the domain must be verified in Resend.
# e.g. "Purpose House <hello@yourdomain.org>"; left empty, Resend's test sender is used.
EMAIL_FROM=

# Database (Postgres)
# Local development: the Postgres in Docker (`bun run db:up`, see docker-compose.yml).
# Production: your hosted Postgres's connection string (Neon, Supabase, RDS, …).
DATABASE_URL=postgres://phfi:phfi@localhost:5432/phfi

# YouTube live streaming
# The channel whose live streams appear on /live (the ID starts with UC).
YOUTUBE_CHANNEL_ID=
# YouTube Data API v3 key, used to check whether the channel is live.
# Create one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
# Development only: pretend the channel is live with this video ID, to test the player and chat.
LIVE_PREVIEW_VIDEO_ID=

# Development only: show the full sample library on /watch even with a channel connected (1 to turn on).
WATCH_PREVIEW_SAMPLES=

# Who can read prayer requests and messages at /inbox: email addresses, separated by commas.
# They sign in like anyone else (Google, or a code by email), which proves they own the address.
TEAM_EMAILS=

# Optional: fill the Watch pages from a different YouTube channel (UC…), e.g. for a
# presentation. The live check still uses YOUTUBE_CHANNEL_ID.
WATCH_CHANNEL_ID=
