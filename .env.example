# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database (libSQL / SQLite)
# Local development: a file in the project folder.
# Production: your Turso database URL, e.g. libsql://phfi-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
