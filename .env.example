# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database (libSQL / SQLite)
# Local development: a file in the project folder.
# Production: your Turso database URL, e.g. libsql://phfi-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# YouTube live streaming
# The channel whose live streams appear on /live (the ID starts with UC).
YOUTUBE_CHANNEL_ID=
# YouTube Data API v3 key, used to check whether the channel is live.
# Create one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
# Development only: pretend the channel is live with this video ID, to test the player and chat.
LIVE_PREVIEW_VIDEO_ID=

# Development only: show the full sample library on /watch even with a channel connected (1 to turn on).
WATCH_PREVIEW_SAMPLES=

# Who can read prayer requests and messages at /inbox: email addresses, separated by commas.
# Each also needs a sign-in: bun --env-file=.env.local scripts/add-team-member.ts email "Name"
TEAM_EMAILS=

# Optional: fill the Watch pages from a different YouTube channel (UC…), e.g. for a
# presentation. The live check still uses YOUTUBE_CHANNEL_ID.
WATCH_CHANNEL_ID=
