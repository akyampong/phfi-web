# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database (libSQL / SQLite)
# Local development: a file in the project folder.
# Production: your Turso database URL, e.g. libsql://phfi-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# YouTube live streaming
# The channel whose live streams appear on /live (the ID starts with UC).
YOUTUBE_CHANNEL_ID=
# YouTube Data API v3 key, used to check whether the channel is live.
# Create one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
# Development only: pretend the channel is live with this video ID, to test the player and chat.
LIVE_PREVIEW_VIDEO_ID=
